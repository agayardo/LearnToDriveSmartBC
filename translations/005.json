 "regions": [{"ids": ["r01"], "html": "<p>зміст</p>"},
             {"ids": ["r02"], "html": "<p style=\"font-family:an600;margin:0 0 3.7pt 0\">Використання цього посібника........................................................&nbsp;1</p><p style=\"font-family:an600;margin:0 0 3.7pt 0;color:#231f20\">Нові водії.................................................................................................&nbsp;1</p><p style=\"font-family:an600;margin:0 0 3.7pt 0;color:#231f20\">Досвідчені водії....................................................................................&nbsp;1</p><p style=\"font-family:an600;margin:0 0 3.7pt 0;color:#231f20\">Як отримати максимум від цього посібника.................................&nbsp;1</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:9.0pt\">Структура.............................................................................................2</p><p style=\"font-family:an400;margin:0 0 0pt 0;color:#231f20;margin-left:9.0pt\">Елементи оформлення.......................................................................3</p>"},
             {"ids": ["r03"], "html": "<p>Розвиток навичок розумного водіння</p>"},
             {"ids": ["r04"], "html": "<p>Розділ 1</p>"},
             {"ids": ["r05"], "html": "<p style=\"font-family:an600;margin:0 0 3.7pt 0\">Ви за кермом.........................................................................................&nbsp;5</p><p style=\"font-family:an600;margin:0 0 3.7pt 0;color:#231f20\">Будьте водієм, який думає.................................................................&nbsp;5</p><p style=\"font-family:an600;margin:0 0 3.7pt 0;color:#231f20\">Будьте у формі для водіння................................................................&nbsp;6</p><p style=\"font-family:an600;margin:0 0 3.7pt 0;color:#231f20\">Приймайте правильні рішення.........................................................&nbsp;6</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:9.0pt\">Продовжуйте вчитися........................................................................7</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:9.0pt\">Плануйте водіння................................................................................8</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:9.0pt\">Прогнозуйте дорожню ситуацію.....................................................8</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:9.0pt\">Думайте самостійно...........................................................................9</p><p style=\"font-family:an600;margin:0 0 3.7pt 0;color:#231f20\">Беріть на себе відповідальність.....................................................&nbsp;10</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:9.0pt\">Ви, водій.............................................................................................10</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:9.0pt\">Ваші пасажири..................................................................................11</p><p style=\"font-family:an400;margin:0 0 0pt 0;color:#231f20;margin-left:9.0pt\">Інші учасники дорожнього руху....................................................12</p>"},
             {"ids": ["r06"], "html": "<p>Розділ 2</p>"},
             {"ids": ["r07"], "html": "<p style=\"font-family:an600;margin:0 0 3.7pt 0\">Ви і ваш транспортний засіб...........................................................&nbsp;13</p><p style=\"font-family:an600;margin:0 0 3.7pt 0;color:#231f20\">Налаштуйте для безпеки..................................................................&nbsp;13</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:9.0pt\">Сидіння...............................................................................................13</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:9.0pt\">Підголівники.......................................................................................13</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:9.0pt\">Паски безпеки...................................................................................14</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:9.0pt\">Дитячі системи безпеки..................................................................15</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:22.5pt\">Етап 1 — обличчям назад............................................................15</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:22.5pt\">Етап 2 — обличчям уперед із фіксувальним ременем..........15</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:22.5pt\">Етап 3 — бустер............................................................................15</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:22.5pt\">Етап 4 — лише пасок безпеки....................................................16</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:9.0pt\">Подушки безпеки..............................................................................16</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:9.0pt\">Дзеркала.............................................................................................17</p><p style=\"font-family:an600;margin:0 0 3.7pt 0;color:#231f20\">Ручні органи керування...................................................................&nbsp;17</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:9.0pt\">Рульове колесо..................................................................................18</p><p style=\"font-family:an400;margin:0 0 3.7pt 0;color:#231f20;margin-left:9.0pt\">Замок запалювання..........................................................................18</p><p style=\"font-family:an400;margin:0 0 0pt 0;color:#231f20;margin-left:9.0pt\">Важіль перемикання передач........................................................18</p>"}]}
